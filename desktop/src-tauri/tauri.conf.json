{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KusShoes Editor",
  "version": "0.1.2",
  "identifier": "com.kusshoes.editor",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "kusshoes-editor"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1MEE3Q0QxQjNGMjVBRUQKUldUdFd2S3owWHdLNVh0M1F2bFd4bnpzMDV2ZHZ4dXVzaHdSQmp1S0VFUXpWQUs1S1p3dFg1WVkK",
      "endpoints": [
        "https://github.com/EXE-CAPSTONE-TEAM/ar-ai-exe/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev -- --host 127.0.0.1 --mode desktop",
    "devUrl": "http://127.0.0.1:5173/?desktop=1",
    "beforeBuildCommand": "npm --prefix ../frontend run build -- --mode desktop",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KusShoes Editor",
        "url": "index.html?desktop=1",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset: data: blob:; connect-src 'self' ipc: http://ipc.localhost blob: data: http://127.0.0.1:* https: ws://127.0.0.1:* wss:; img-src 'self' http://127.0.0.1:* https: data: blob:; media-src 'self' http://127.0.0.1:* https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "../dependencies/blender.windows.json",
      "../dependencies/BLENDER-NOTICE.txt",
      "../dependencies/tools",
      "../sidecars/*",
      "../../data/3DModel.glb"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "KusShoes",
    "shortDescription": "KusShoes Editor",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
