<?xml version="1.0" encoding="utf-8"?>
<!--
  Blanket usesCleartextTraffic is disabled for the release build. This scopes
  plain-http back on for loopback only, so a dev build pointed at the emulator
  host still works while no developer's LAN address ships in the APK.

  To test against a machine on the LAN, add its address here locally, keep that
  change out of the commit, and pass the hosts explicitly with the dart-define
  flags documented in lib/config/app_config.dart.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
